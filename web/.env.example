# URL de connexion Postgres (production/dev)
DATABASE_URL=postgres://user:password@localhost:5432/polyqr

# URL de connexion Postgres dédiée aux tests (schéma appliqué et nettoyé à chaque suite)
DATABASE_URL_TEST=postgres://user:password@localhost:5432/polyqr_test

# Secret HMAC de signature du cookie de session (bénévole/admin). Générer avec `openssl rand -hex 32`.
SESSION_SECRET=change-me

# URL publique de l'app, utilisée pour construire le lien vers la page billet dans l'email.
APP_URL=http://localhost:3000

# Compte SMTP de l'association utilisé pour l'envoi des emails de billet.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=association@example.org
SMTP_PASSWORD=change-me
SMTP_FROM="Association Poly <association@example.org>"

# Secret partagé du webhook HelloAsso (HelloAsso ne signe pas ses notifications :
# ce secret est ajouté en paramètre de l'URL de callback déclarée dans son
# back-office, ex. https://.../api/webhooks/helloasso?secret=...). Générer avec
# `openssl rand -hex 32`.
HELLOASSO_WEBHOOK_SECRET=change-me

# Identifiants API HelloAsso (Mon Compte > Intégrations et API sur HelloAsso),
# utilisés en OAuth2 client_credentials pour l'appel de suivi GET /items/{id}
# qui détermine si l'option "ticket boisson" a été prise (voir docs/CONTEXT.md).
# En sandbox, utiliser https://api.helloasso-sandbox.com comme base URL.
HELLOASSO_API_BASE_URL=https://api.helloasso.com
HELLOASSO_CLIENT_ID=change-me
HELLOASSO_CLIENT_SECRET=change-me
