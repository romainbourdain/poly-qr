# URL de connexion Postgres (production/dev)
DATABASE_URL=postgres://user:password@localhost:5432/polyqr

# URL de connexion Postgres dédiée aux tests (schéma appliqué et nettoyé à chaque suite)
DATABASE_URL_TEST=postgres://user:password@localhost:5432/polyqr_test

# Secret HMAC de signature des cookies de session (admin et scanner). Générer avec `openssl rand -hex 32`.
SESSION_SECRET=change-me

# Mot de passe de l'espace admin (partagé entre les organisateurs). Les bénévoles
# du scanner, eux, ont un mot de passe par événement, défini dans l'admin.
ADMIN_PASSWORD=change-me

# URL publique de l'app, utilisée pour construire le lien vers la page billet dans l'email.
APP_URL=http://localhost:3000

# Emails de billet. SMTP_FROM est l'expéditeur ("Nom <adresse>") ; avec Brevo,
# l'adresse doit être un expéditeur vérifié (Brevo → Senders, Domains, IPs).
SMTP_FROM="BDE TPS <billetterie@example.org>"

# Production : API HTTPS de Brevo (port 443, contourne les hébergeurs qui
# bloquent le SMTP sortant). Clé : Brevo → SMTP & API → Clés API.
# BREVO_API_KEY=xkeysib-...

# Développement : SMTP, par exemple Mailpit (interface sur http://localhost:8025).
# Ignoré si BREVO_API_KEY est définie.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit

# Secret partagé du webhook HelloAsso (HelloAsso ne signe pas ses notifications :
# ce secret est ajouté en paramètre de l'URL de callback déclarée dans son
# back-office, ex. https://.../api/webhooks/helloasso/<id-evenement>?secret=..., l'admin
# affiche l'URL complète de chaque événement). Générer avec
# `openssl rand -hex 32`.
HELLOASSO_WEBHOOK_SECRET=change-me

# Optionnel : à 1, désactive la validation des variables (build Docker sans secrets).
# SKIP_ENV_VALIDATION=1

# Docker compose uniquement : mot de passe du Postgres du conteneur `db`
# (DATABASE_URL est alors construite par docker-compose.yml).
# POSTGRES_PASSWORD=…
